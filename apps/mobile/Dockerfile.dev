# Multi-stage Dockerfile for Expo mobile app development
# Optimized for pnpm monorepo with hoisted node_modules
# Configured for LAN access via Metro bundler

# Stage 1: Dependencies
FROM node:20-alpine AS dependencies

WORKDIR /app

# Copy workspace configuration and lock file
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all package.json files from apps and packages
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/config/package.json ./packages/config/

# Install pnpm and dependencies
RUN npm install -g pnpm@9.0.0 && \
    pnpm install --frozen-lockfile

# Stage 2: Development
FROM node:20-alpine AS development

# Install additional tools for Expo
RUN apk add --no-cache bash curl

WORKDIR /app

# Copy node_modules from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/.pnpm-store ./.pnpm-store

# Copy workspace files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all source code
COPY apps/mobile ./apps/mobile
COPY packages/config ./packages/config

# Expose Metro bundler port and debugging ports
EXPOSE 8081 19000 19001

# Start Expo dev server
# REACT_NATIVE_PACKAGER_HOSTNAME is set via docker-compose environment
CMD ["pnpm", "--filter", "mobile", "dev"]
