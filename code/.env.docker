# =============================================================================
# Docker Compose environment overrides
# Copy this to .env when running with `docker compose up`
# =============================================================================

# --- Postgres (local container) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spl_dev

# --- Better Auth ---
BETTER_AUTH_SECRET=docker-dev-secret-replace-in-production

# --- App URLs ---
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# --- Optional: Google OAuth (fill in for social login) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: Cookie domain for cross-subdomain auth ---
# COOKIE_DOMAIN=.example.com
