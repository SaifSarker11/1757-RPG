# =============================================================================
# 1757 monorepo — single source of truth (copy to .env at this same directory)
# All apps (api, web, admin, mobile) load variables from this root file.
# =============================================================================

# --- Database (Neon Postgres) ---
# DATABASE_URL: pooled connection (host contains "-pooler") — used by the API at runtime
# DIRECT_URL: direct connection — used by Prisma CLI (migrate, db push, generate)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth (hosted on Fastify API, NOT Next.js) ---
BETTER_AUTH_SECRET="generate-with: npx @better-auth/cli secret"
BETTER_AUTH_URL="http://localhost:3001"

# --- App URLs (used for CORS + trustedOrigins) ---
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
API_URL="http://localhost:3001"
PORT="3001"

# --- Client-facing public vars ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
# Mobile: localhost is auto-replaced with your LAN IP when using Expo Go.
# Android emulator uses 10.0.2.2 automatically. Override only if needed:
EXPO_PUBLIC_API_URL="http://localhost:3001"

# --- Optional production cookie domain (enables cross-subdomain HttpOnly cookies) ---
# COOKIE_DOMAIN=".example.com"

# --- Redis (Upstash / Render / Local) ---
# REDIS_URL is used by the API for live game state snapshots and 2-hour TTL cache
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Runtime ---
# Set to "production" on Render / deployed environments
NODE_ENV="development"

# =============================================================================
# Render production checklist:
#   1. DATABASE_URL  → Neon pooled connection string
#   2. DIRECT_URL    → Neon direct connection string
#   3. REDIS_URL     → Upstash rediss:// URL or Render internal Redis
#   4. BETTER_AUTH_SECRET → strong random value
#   5. BETTER_AUTH_URL    → https://your-api.onrender.com
#   6. WEB_URL / ADMIN_URL → deployed Vercel origins
#   7. NODE_ENV      → production
#   8. COOKIE_DOMAIN → .yourdomain.com (if using custom domain)
# =============================================================================
