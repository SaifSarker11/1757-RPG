{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "ES2020",
    "module": "ESNext",
    "baseUrl": "../../",
    "paths": {
      "@repo/*": ["packages/*"]
    }
  }
}