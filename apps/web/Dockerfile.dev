# Multi-stage Dockerfile for Next.js web app development
# Optimized for pnpm monorepo with hoisted node_modules

# Stage 1: Dependencies
FROM node:20-alpine AS dependencies

WORKDIR /app

# Copy workspace configuration and lock file
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all package.json files from apps and packages
COPY apps/web/package.json ./apps/web/
COPY packages/config/package.json ./packages/config/

# Install pnpm and dependencies
RUN npm install -g pnpm@9.0.0 && \
    pnpm install --frozen-lockfile

# Stage 2: Development
FROM node:20-alpine AS development

WORKDIR /app

# Copy node_modules from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/.pnpm-store ./.pnpm-store

# Copy workspace files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all source code
COPY apps/web ./apps/web
COPY packages/config ./packages/config

# Expose Next.js port
EXPOSE 3000

# Start Next.js dev server
CMD ["pnpm", "--filter", "web", "dev"]
