# =============================================================================
# 1757 monorepo — copy to .env in this same directory and fill in locally.
# All apps (api, web, admin, mobile) load variables from this root file.
# Names only — never commit values.
# =============================================================================

# --- Database (Neon Postgres) ---
# DATABASE_URL: pooled connection, used by the API at runtime
# DIRECT_URL: direct connection, used by the Prisma CLI (db push, generate)
DATABASE_URL=
DIRECT_URL=

# --- Better Auth (hosted on the Fastify API) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- App URLs (CORS + trustedOrigins) ---
WEB_URL=
ADMIN_URL=
API_URL=
PORT=

# --- Client-facing public vars ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
EXPO_PUBLIC_API_URL=

# --- Redis ---
# REDIS_URL: TCP client (ioredis). Local Docker or the Upstash rediss:// endpoint.
REDIS_URL=
# Upstash REST API — one-off calls only (no pub/sub, no Socket.IO adapter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: production cookie domain (cross-subdomain HttpOnly cookies) ---
# COOKIE_DOMAIN=
