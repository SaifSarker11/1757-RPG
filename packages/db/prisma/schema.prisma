generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  isAnonymous   Boolean   @default(false)
  /// 3-15 alphanumeric; enforced at signup. Optional until existing users pick one.
  username      String?   @unique
  avatarId      String?
  xp            Int       @default(0)
  level         Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  rooms         Room[]
  roomPlayers   RoomPlayer[]
  matchPlayers  MatchPlayer[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum PlayerTeam {
  GREEN
  RED
  GOLD
}

enum PlayerRole {
  NAWAB_SIRAJ
  LUTFUNNESA
  MIR_MADAN
  MOHON_LAL
  SAINT_FRASY
  DE_BUSSY
  MIR_JAFAR
  UMICHAD
  JEAN_LAW
  GHASHETI_BEGUM
  YAR_LUTUF
  TARA_BAI
  RAI_DURLABH
  JAGAT_SETH
  RAJA_RAMNARAIN
  LOYALIST
  EIC_SPY
}

model Room {
  id          String       @id @default(cuid())
  code        String       @unique
  hostUserId  String
  host        User         @relation(fields: [hostUserId], references: [id])
  status      RoomStatus   @default(WAITING)
  maxPlayers  Int          @default(15)
  /// Listed in the public lobby and eligible for Quick Join.
  isPublic    Boolean      @default(true)
  discussionSeconds Int    @default(120)
  /// Named roles the host allows. Nawab Siraj is always added by the engine.
  enabledRoles PlayerRole[] @default([NAWAB_SIRAJ, LUTFUNNESA, MIR_MADAN, MOHON_LAL, SAINT_FRASY, DE_BUSSY, RAJA_RAMNARAIN, MIR_JAFAR, UMICHAD, JEAN_LAW, GHASHETI_BEGUM, YAR_LUTUF, TARA_BAI, RAI_DURLABH, JAGAT_SETH])
  /// Users the host kicked; they can't rejoin this room.
  bannedUserIds String[]   @default([])
  currentRound Int         @default(1)
  greenWins   Int          @default(0)
  redWins     Int          @default(0)
  roundRejections Int      @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  players     RoomPlayer[]
  rounds      RoundRecord[]

  @@index([code])
  @@map("room")
}

model RoomPlayer {
  id               String     @id @default(cuid())
  roomId           String
  room             Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId           String
  user             User?      @relation(fields: [userId], references: [id])
  socketId         String?
  role             PlayerRole?
  team             PlayerTeam?
  isSelector       Boolean    @default(false)
  isLockedByJeanLaw  Boolean   @default(false)
  hasUsedDeBussyLock Boolean  @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([roomId, userId])
  @@unique([roomId, socketId])
  @@index([roomId])
  @@map("room_player")
}

model RoundRecord {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundNumber     Int
  phase           String   @default("DISCUSSION")
  selectorId      String?
  selectedTeam    String[] @default([])
  teamVotes       Json?
  missionVotes    Json?
  greenVotes      Int      @default(0)
  redVotes        Int      @default(0)
  winner          PlayerTeam?
  rejectionCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roomId, roundNumber])
  @@map("round_record")
}

// --- Finished matches (written once, at match end) ---------------------------

enum MatchEndReason {
  ROUNDS
  MIR_JAFAR_GUESS
  JAGAT_SETH_GUESS
}

enum RoundEndReason {
  MISSION
  DEADLOCK
}

enum BallotChoice {
  APPROVE
  REJECT
}

model Match {
  id          String         @id @default(cuid())
  roomCode    String
  playerCount Int
  startedAt   DateTime
  endedAt     DateTime
  winner      PlayerTeam
  reason      MatchEndReason
  roundsGreen Int
  roundsRed   Int
  /// Host settings the match was played with.
  config      Json
  createdAt   DateTime       @default(now())
  players     MatchPlayer[]
  rounds      MatchRound[]

  @@index([roomCode])
  @@index([endedAt])
  @@map("match")
}

model MatchPlayer {
  id                  String     @id @default(cuid())
  matchId             String
  match               Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// Null for guests.
  userId              String?
  user                User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId             String?
  seat                Int
  role                PlayerRole
  team                PlayerTeam
  won                 Boolean
  /// Jean Law locked this Green player (humiliation trophy).
  jeanLawLocked       Boolean    @default(false)
  disconnectedForfeit Boolean    @default(false)

  @@unique([matchId, seat])
  @@index([userId])
  @@map("match_player")
}

model MatchRound {
  id            String         @id @default(cuid())
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  number        Int
  /// Leader of the approved nomination, or of the last attempt if deadlocked.
  leaderSeat    Int
  teamSeats     Int[]
  approved      Boolean
  successCount  Int
  sabotageCount Int
  result        PlayerTeam
  reason        RoundEndReason
  ballotVotes   BallotVote[]

  @@unique([matchId, number])
  @@map("match_round")
}

model BallotVote {
  id      String       @id @default(cuid())
  roundId String
  round   MatchRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  attempt Int
  seat    Int
  vote    BallotChoice
  weight  Int

  @@unique([roundId, attempt, seat])
  @@map("ballot_vote")
}
