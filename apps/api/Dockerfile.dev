# Multi-stage Dockerfile for Fastify API development
# Optimized for pnpm monorepo with hoisted node_modules

# Stage 1: Dependencies
FROM node:20-alpine AS dependencies

# Install required system dependencies for Prisma
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy workspace configuration and lock file
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all package.json files from apps and packages
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/

# Install pnpm and dependencies
RUN npm install -g pnpm@9.0.0 && \
    pnpm install --frozen-lockfile

# Stage 2: Development
FROM node:20-alpine AS development

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy node_modules from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/.pnpm-store ./.pnpm-store

# Copy workspace files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all source code
COPY apps/api ./apps/api
COPY packages/db ./packages/db
COPY packages/auth ./packages/auth
COPY packages/config ./packages/config

# Generate Prisma client
RUN pnpm --filter @repo/db db:generate

# Expose API port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start API with database schema push
CMD ["sh", "-c", "pnpm --filter @repo/db db:push && pnpm --filter api dev"]
